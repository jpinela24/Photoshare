# Build output
# `go build` with no -o names the binary after the module (photo-share), which
# is not the same string as the installer's product name (photoshare) — both
# get dropped in the repo root, so both are ignored here.
photo-share
photoshare
photoshare.exe
windows/Output/
client/dist/
client/node_modules/

# Runtime / per-machine
photoshare.config.json
photoshare.log
cert.pem
key.pem

# OS / editor clutter
.DS_Store
*.log

# Generated Windows resources (rebuilt from windows/icon.ico + versioninfo.json)
resource_windows_amd64.syso
resource_windows_arm64.syso
